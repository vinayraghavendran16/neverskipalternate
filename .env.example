# Public browser-safe values from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Required only for trusted administration and migrations.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Canonical application URL used by auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional observability release identifier.
NEXT_PUBLIC_RELEASE_SHA=local
